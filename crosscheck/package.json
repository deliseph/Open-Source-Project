{
  "name": "crosscheck",
  "version": "0.1.0",
  "description": "An office for your AI coding agents. Claude Code writes it, Codex reviews it, Gemini breaks the tie — and you watch it happen.",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "code-review",
    "claude-code",
    "codex",
    "gemini-cli",
    "aider",
    "orchestration",
    "cli",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "crosscheck": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
